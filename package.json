{
  "name": "dsh-search-switch",
  "version": "0.1.0",
  "description": "Choose the DeepSeek Harness web-search provider (DeepSeek Messages, DeepSeek Search API, or Codex) from Settings > General.",
  "type": "module",
  "license": "MIT",
  "author": "時雨てる",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeqingMoe/dsh-search-switch.git"
  },
  "homepage": "https://github.com/KeqingMoe/dsh-search-switch#readme",
  "bugs": {
    "url": "https://github.com/KeqingMoe/dsh-search-switch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "search-provider"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "build": "pnpm run typecheck && pnpm run clean && tsdown",
    "prepublishOnly": "pnpm run lint && pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "test": "pnpm run build && node --test",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "lint:fix": "biome check --write ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "18.3.7",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3"
  }
}
